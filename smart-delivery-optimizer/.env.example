# Copy to .env (git-ignored) and fill in. Never commit .env.

# PostgreSQL credentials (used by docker compose, the backend and import_data.py)
DB_USERNAME=postgres
DB_PASSWORD=change-me

# Backend (only needed when running outside docker compose)
DB_URL=jdbc:postgresql://localhost:5432/smart_delivery_optimizer
# "database" (PostgreSQL) or "csv" (bundled dataset, no database needed)
APP_DATA_SOURCE=database
CORS_ALLOWED_ORIGINS=http://localhost:5173
